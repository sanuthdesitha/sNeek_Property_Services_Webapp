/// Resend webhook telemetry per campaign recipient (delivered / opened /
/// clicked / bounced / complained). Written by app/api/webhooks/resend, which
/// maps the provider's `email_id` back to a campaign via CampaignSend.externalId.
/// Append-only — the per-campaign stats strip aggregates over it.
model EmailCampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  recipient  String
  type       String // DELIVERED | OPENED | CLICKED | BOUNCED | COMPLAINED | DELAYED | SENT
  meta       Json?
  createdAt  DateTime @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, type])
  @@index([recipient])
}

/// Per-recipient send ledger for email campaigns. A unique (campaignId, email)
/// row is written the first time a recipient is contacted, so a dispatch that
/// crashes/retries never re-emails someone already sent to. Also lets a stuck
/// campaign be safely resumed (skip rows already present).
model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  email      String
  status     String   @default("SENT") // SENT | FAILED
  error      String?  @db.Text
  /// Provider message id (Resend `email_id`). The only link back from a webhook
  /// event to the campaign that produced it.
  externalId String?
  createdAt  DateTime @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([externalId])
}

/// Channel-independent email suppression list, keyed on the address itself so
/// unsubscribes/complaints for CLIENT emails with no User row are still honoured
/// (User.emailStatus only covered addresses that had a User). Non-transactional
/// sends check this in addition to User.emailStatus.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // HARD_BOUNCE | SOFT_BOUNCE | COMPLAINT | UNSUBSCRIBED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

