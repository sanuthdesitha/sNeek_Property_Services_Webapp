model QuoteLead {
  id                    String     @id @default(cuid())
  clientId              String?
  serviceType           JobType
  name                  String
  email                 String
  phone                 String?
  address               String?
  suburb                String?
  bedrooms              Int?
  bathrooms             Int?
  hasBalcony            Boolean    @default(false)
  notes                 String?    @db.Text
  estimateMin           Float?
  estimateMax           Float?
  requestedServiceLabel String?
  promoCode             String?
  structuredContext     Json?
  status                LeadStatus @default(NEW)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
  quotes Quote[]
}

model Quote {
  id              String      @id @default(cuid())
  leadId          String?
  clientId        String?
  serviceType     JobType
  lineItems       Json // array of { label, unitPrice, qty, total }
  subtotal        Float
  gstAmount       Float
  totalAmount     Float
  notes           String?     @db.Text
  validUntil      DateTime?
  status          QuoteStatus @default(DRAFT)
  convertedJobId  String?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  // Shareable public link: the client views + approves the quote at
  // /q/<publicToken> without logging in; the page always reflects the latest
  // saved quote (live). Null until the quote is first sent/shared.
  publicToken     String?     @unique
  // When false (default), add-on prices are hidden from the client (email +
  // online) — prices change often, so we usually show add-ons as "on request".
  showAddOnPrices Boolean     @default(false)
  // Client-supplied reference images attached to the quote: [{ key, url, label }].
  referenceImages Json?
  // Snapshot of the configurable pricing variables chosen for this quote
  // (property condition, location, parking + how it's paid, etc.).
  serviceContext  Json?
  // Service cadence chosen on the quote: one_off | weekly | fortnightly | monthly.
  // Drives whether conversion creates a single job or a recurring schedule.
  frequency       String?
  // Explicit service address on the quote (for leads without a linked property,
  // and so conversion can create/find a property from it).
  serviceAddress  String?
  serviceSuburb   String?
  // Pending add-ons the client asked for from the public quote page, awaiting
  // the admin to price them in and re-send. Cleared as each is added/dismissed.
  // Shape: [{ id?, label, price, note?, requestedAt }].
  requestedAddOns Json?
  // Applied coupon code (DiscountCampaign.code) when a campaign discount is on
  // this quote. The discount amount itself lives as a negative line item; this
  // tracks which coupon so usage counts + removal stay accurate. Null = none or
  // a manual (codeless) discount.
  discountCode    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lead   QuoteLead?   @relation(fields: [leadId], references: [id])
  client Client?      @relation(fields: [clientId], references: [id])
  events QuoteEvent[]
}

// Timeline of everything that happens to a quote: emails we send + client
// responses (viewed / accepted / declined / add-ons requested) + conversion.
// Surfaced on the admin quote detail and updated automatically by the send /
// public-response / convert flows.
model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  type      String // EMAIL_SENT | VIEWED | ACCEPTED | DECLINED | ADDON_REQUESTED | CONVERTED | NOTE
  detail    Json? // { recipients?, note?, items?, total?, ... }
  createdAt DateTime @default(now())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([createdAt])
}

model ShoppingRun {
  id           String            @id @default(cuid())
  ownerUserId  String
  clientId     String?
  status       ShoppingRunStatus @default(DRAFT)
  title        String
  notes        String?           @db.Text
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  closedAt     DateTime?
  legacySource Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  owner        User                 @relation("ShoppingRunOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
