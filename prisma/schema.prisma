model LaundryRoute {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime // Sydney day, startOfDay-normalized like LaundryTask dates
  stops     Json
  status    String    @default("DRAFT") // DRAFT|ACTIVE|COMPLETED|ABANDONED
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([status, date])
}

model LaundryTask {
  id                 String        @id @default(cuid())
