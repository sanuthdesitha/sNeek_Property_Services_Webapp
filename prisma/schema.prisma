// ─────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────

model Job {
  id                        String    @id @default(cuid())
  jobNumber                 String    @unique
  propertyId                String
  reservationId             String?   @unique
  jobType                   JobType
  status                    JobStatus @default(UNASSIGNED)
  scheduledDate             DateTime // date of cleaning (UTC start of day)
  startTime                 String? // HH:mm (property local)
  endTime                   String? // HH:mm (property local)
  dueTime                   String? // latest completion HH:mm
  estimatedHours            Float?
  actualHours               Float?
  notes                     String?   @db.Text
  internalNotes             String?   @db.Text
  // Agreed/negotiated fixed client price for this job. When set, it overrides
  // the property/job-type PropertyClientRate on the client invoice and lets the
  // job be invoiced even if no standard rate exists. null = use the rate table.
  fixedPrice                Float?
  // Note printed on the client invoice line (and shown in the admin invoicing UI).
  invoiceNote               String?   @db.Text
  // Actual completion date/time. Drives which payroll + client-invoice period the
  // job falls into (falls back to scheduledDate when null). Stamped on QA pass and
  // editable by admins for next-day / custom completion dates.
  completedAt               DateTime?
  // Set when this job's cleaner pay has been included in a payroll run. Prevents
  // the same job being paid again in a later/overlapping run (payroll idempotency).
  payrollRunId              String?
  // Set when the cleaner's invoice covering this job has been marked PAID by admin
  // (parallel to payrollRunId — the cleaner-invoice payment path). Cleared if the
  // invoice is reversed/deleted so the job can be re-invoiced + re-paid.
  cleanerPaidAt             DateTime?
  // ── Rework / reclean ──────────────────────────────────────────────────────
  // A rework job is a distinct Job created when QA fails a clean. It carries the
  // QA-flagged areas (+ the photos QA captured) so the cleaner sees exactly what
  // to fix and uploads "after" photos per area. Rework jobs never create laundry
  // pickups. Pay rule: when the SAME cleaner redoes it → no pay (reworkPayAmount
  // null/0); when a DIFFERENT cleaner redoes it → that cleaner is paid
  // reworkPayAmount and the same amount is deducted from the original cleaner.
  isRework                  Boolean   @default(false)
  reworkOfJobId             String?
  reworkReason              String?   @db.Text
  reworkAreas               Json? // [{ id, label, note, photoKeys: string[] }]
  reworkPayAmount           Float? // amount paid to the rework cleaner (and deducted from the original)
  reworkPayeeCleanerId      String? // cleaner who will be paid for the rework
  reworkDeductFromCleanerId String? // original cleaner the amount is deducted from (null = same cleaner)
  reworkDeductionApplied    Boolean   @default(false)
  reworkSourceReviewId      String? // the failing QAReview that triggered this rework
  // Allowed cleaners can clock out before completing the form. The clock stops
  // and the job is parked as "form pending" — it is NOT considered completed
  // until the form is submitted (which then flows through SUBMITTED → QA).
  formPendingAfterClockOut  Boolean   @default(false)
  clockedOutEarlyAt         DateTime?
  // JOB-LEVEL TEMPLATE PIN. Set when a form was minted FOR THIS JOB — today only
  // by quote → job conversion, which materialises the agreed/standard scope the
  // client accepted. It is the highest-priority input to
  // lib/forms/resolve-job-template.ts and applies to THIS job only; every other
  // job at the property keeps normal resolution (property override → newest
  // active global). Before this column existed the conversion registered its
  // one-off template as the property's PERMANENT override, so every future job
  // of that type at that property rendered one quote's scope and never saw the
  // admin's edits to the real global template.
  formTemplateId            String?
  priorityBucket            Int       @default(4)
  priorityReason            String?
  sameDayCheckin            Boolean   @default(false)
  sameDayCheckinTime        String?
  // reminder overrides (null = use system defaults)
  reminder24hSent           Boolean   @default(false)
  reminder2hSent            Boolean   @default(false)
  gpsCheckInLat             Float?
  gpsCheckInLng             Float?
  gpsCheckInAt              DateTime?
  gpsCheckOutLat            Float?
  gpsCheckOutLng            Float?
  gpsCheckOutAt             DateTime?
  gpsDistanceMeters         Int?
  gpsCheckInAccuracyM       Float?
  gpsCheckInConfirmed       Boolean   @default(false)
  gpsCheckInAdjusted        Boolean   @default(false)
  gpsCheckInNote            String?   @db.Text
  /// Why the cleaner started this job away from the property. A CODED value
  /// (see lib/gps/off-site-reasons.ts) rather than free text, so off-site
  /// starts can actually be counted and compared instead of read one by one.
  /// Null = started on site, or predates the on-site gate.
  gpsCheckInReasonCode      String?
  requiresSafetyCheckin     Boolean   @default(false)
  safetyCheckinAt           DateTime?
  // Skip / don't-clean: a client can request the clean be skipped, or an admin
  // can set it directly. NONE | REQUESTED | SKIPPED | DECLINED.
  cleanSkipStatus           String    @default("NONE")
  cleanSkipReason           String?   @db.Text
  cleanSkipRequestedById    String?
  cleanSkipDecidedById      String?
  cleanSkipAt               DateTime?
  manuallyRescheduledAt     DateTime?
  rescheduledBy             String?
  enRouteStartedAt          DateTime?
  enRouteEtaMinutes         Int?
  enRouteEtaUpdatedAt       DateTime?
  drivingPausedAt           DateTime?
  drivingPauseReason        String?
  drivingDelayedAt          DateTime?
  drivingDelayedReason      String?
  arrivedAt                 DateTime?
  // Set when GPS confirms the cleaner left the site (sustained outside-fence
  // run — see lib/gps/departure.ts). Cleared when a fresh inside-fence ping
  // arrives (re-entry).
  departedAt                DateTime?
  lastEtaNotificationAt     DateTime?
  lastEtaNotifiedMinutes    Int?
  lastDelayedNotificationAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  property               Property                   @relation(fields: [propertyId], references: [id])
  reservation            Reservation?               @relation(fields: [reservationId], references: [id])
  formTemplate           FormTemplate?              @relation("JobPinnedFormTemplate", fields: [formTemplateId], references: [id], onDelete: SetNull)
  reworkOfJob            Job?                       @relation("JobRework", fields: [reworkOfJobId], references: [id], onDelete: SetNull)
  reworkChildren         Job[]                      @relation("JobRework")
  assignments            JobAssignment[]
  timeLogs               TimeLog[]
  formSubmissions        FormSubmission[]
  qaReviews              QAReview[]
  qaAssignments          QaAssignment[]
  qaFormSubmissions      QaFormSubmission[]
  qaReworkTransfers      QaReworkTransfer[]
  mediaOverrideRequests  MediaOverrideRequest[]
  rotationCompletions    PropertyRotationState[]
  qaIssues               QaIssue[]
  maintenanceItems       PropertyMaintenanceItem[]
  laundryTask            LaundryTask?
  report                 Report?
  reportVerification     ReportVerification[]
  issueTickets           IssueTicket[]
  damageReports          DamageReport[]
  payAdjustments         CleanerPayAdjustment[]
  timeAdjustmentRequests TimeLogAdjustmentRequest[]
  auditLogs              AuditLog[]                 @relation("AuditJob")
  invoiceLines           ClientInvoiceLine[]
  jobTasks               JobTask[]
  satisfactionRating     ClientSatisfactionRating?
  cleanerLocationPings   CleanerLocationPing[]
  feedback               JobFeedback?
  uploadFailures         UploadFailure[]

  // Hot-path indexes: job lists, payroll, invoicing, and dashboards filter/sort
  // on status + scheduledDate/completedAt + propertyId.
  @@index([scheduledDate])
  @@index([status, scheduledDate])
  @@index([propertyId, scheduledDate])
  @@index([completedAt])
  @@index([status, completedAt])
  @@index([payrollRunId])
  @@index([isRework, status])
  @@index([reworkOfJobId])
  @@index([formTemplateId])
}

model CleanerPayAdjustment {
  id                     String              @id @default(cuid())
  jobId                  String?
  propertyId             String?
  cleanerId              String
  scope                  PayAdjustmentScope  @default(JOB)
  title                  String?
  type                   PayAdjustmentType
  requestedHours         Float?
  requestedRate          Float?
  requestedAmount        Float
  approvedAmount         Float?
  status                 PayAdjustmentStatus @default(PENDING)
  cleanerNote            String?             @db.Text
  attachmentKeys         Json?
  /// What KIND of money this is, which decides how it prints on an invoice.
  /// SERVICE = work performed. PARKING / REIMBURSEMENT = money the cleaner
  /// already spent out of pocket and is getting back — not income, so it
  /// belongs in its own section rather than inflating the services total.
  category               String              @default("SERVICE")
  /// Whether this line is taxable income to the payee. Defaults true so every
  /// row that existed before the split keeps behaving exactly as it did.
  taxable                Boolean             @default(true)
  /// PRIVATE. The reviewing admin's own record of the decision — "third time
  /// this month", "check with ops first". Internal surfaces only; it must never
  /// travel to the payee. Use `decisionMessage` to explain a decision TO them.
  adminNote              String?             @db.Text
  /// The explanation the CLEANER reads, written knowing they will see it.
  /// Added 2026-08 after `adminNote` was found reaching cleaners by three
  /// separate routes (their job screen, the pay-requests list, and the decision
  /// push/email). Closing those left a rejected request with no explanation at
  /// all — worse than the leak — so the explanation gets its own field rather
  /// than borrowing a private one.
  decisionMessage        String?             @db.Text
  requestedAt            DateTime            @default(now())
  reviewedById           String?
  reviewedAt             DateTime?
  // Stamped with the payroll run that paid this approved adjustment so it can
  // never be included in a second run (idempotency — mirrors Job.payrollRunId
  // and ShoppingSettlement.includedInPayrollRunId).
  includedInPayrollRunId String?
  // Stamped with the CleanerInvoiceSubmission that billed this approved
  // adjustment. Cleaner invoices are the OTHER settlement rail beside payroll
  // runs; without a marker, selection was purely date/job-window based, so an
  // approved addition either never reached an invoice at all (its job was not
  // on the payee's invoice) or could be billed twice by two overlapping
  // periods. Selection is now "APPROVED and neither stamp set".
  includedInCleanerInvoiceId String?
  includedInCleanerInvoiceAt DateTime?
  // Accountability provenance. source: STREAK_5 | STREAK_10 | MONTHLY_RANK_1 |
  // MONTHLY_RANK_2 | QA_RECTIFICATION_PAY | RECTIFICATION_DEDUCTION |
  // REWORK_DEDUCTION (null = manual/legacy). sourceKey is the dedupe key for
  // auto-proposals (e.g. "streak5:<cleanerId>:<jobId>", "monthly:2026-07:1") —
  // proposers must check (source, sourceKey, cleanerId) before creating.
  source                 String?
  sourceKey              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  job        Job?      @relation(fields: [jobId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id])
  cleaner    User      @relation("CleanerAdjustmentRequests", fields: [cleanerId], references: [id])
  reviewedBy User?     @relation("CleanerAdjustmentReviews", fields: [reviewedById], references: [id])

  @@index([cleanerId, status])
  @@index([jobId, status])
  @@index([propertyId, status])
  @@index([includedInPayrollRunId])
  @@index([includedInCleanerInvoiceId])
  @@index([source, sourceKey])
}

model JobAssignment {
  id                    String                      @id @default(cuid())
  jobId                 String
  userId                String
  isPrimary             Boolean                     @default(false)
  payRate               Float? // hourly rate at time of assignment
  assignedAt            DateTime                    @default(now())
  offeredAt             DateTime                    @default(now())
  removedAt             DateTime?
  responseStatus        JobAssignmentResponseStatus @default(PENDING)
  respondedAt           DateTime?
  responseNote          String?                     @db.Text
  assignedById          String?
  transferredFromUserId String?

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
}

model TimeLog {
  id        String    @id @default(cuid())
  jobId     String
  userId    String
  startedAt DateTime
  stoppedAt DateTime?
  durationM Int? // minutes (computed on stop)
  notes     String?

  job                Job                        @relation(fields: [jobId], references: [id])
  user               User                       @relation(fields: [userId], references: [id])
  adjustmentRequests TimeLogAdjustmentRequest[]

  // NOTE: a PARTIAL unique index enforces at most one OPEN log per (jobId,
  // userId): `CREATE UNIQUE INDEX "TimeLog_job_user_open_unique" ON "TimeLog"
  // ("jobId","userId") WHERE "stoppedAt" IS NULL;` — see migration
  // 20260703120000_timelog_open_unique. Prisma can't express a partial unique
  // index here, so it lives in raw SQL only. Do NOT add an @@unique for these
  // columns (it would be a FULL unique index and break re-clock-in after stop).
}

model TimeLogAdjustmentRequest {
  id                 String               @id @default(cuid())
  timeLogId          String
  jobId              String
  cleanerId          String
  requestedDurationM Int
  requestedStoppedAt DateTime?
  originalDurationM  Int
  originalStoppedAt  DateTime?
  reason             String?              @db.Text
  status             TimeAdjustmentStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  adminNote          String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  timeLog    TimeLog @relation(fields: [timeLogId], references: [id], onDelete: Cascade)
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner    User    @relation("TimeAdjustmentRequestedBy", fields: [cleanerId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("TimeAdjustmentReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([jobId, status])
  @@index([cleanerId, status])
}

// ─────────────────────────────────────────────
// Forms Engine
// ─────────────────────────────────────────────

model FormTemplate {
  id               String         @id @default(cuid())
  name             String
  serviceType      JobType
  kind             FormKind       @default(CUSTOM)
  version          Int            @default(1)
  isActive         Boolean        @default(true)
  schema           Json // full template JSON (sections → fields → logic)
  parentTemplateId String?
  parentTemplate   FormTemplate?  @relation("FormTemplateLineage", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  children         FormTemplate[] @relation("FormTemplateLineage")
  publishedAt      DateTime?
  archivedAt       DateTime?
  // JOB-SCOPED one-off: minted for a single job (quote → job conversion) and
  // pinned via Job.formTemplateId. It is active, so the job it belongs to can
  // render it, but it is NOT a candidate for global resolution and must never
  // be auto-archived by a global publish. Property-scoped rows are identified by
  // the settings override map; job-scoped rows have no entry there, so they need
  // this explicit marker.
  isJobScoped      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  submissions FormSubmission[]
  pinnedJobs  Job[]            @relation("JobPinnedFormTemplate")

  @@index([kind, isActive])
}

model FormSubmission {
  id                       String          @id @default(cuid())
  jobId                    String
  templateId               String
  submittedById            String
  data                     Json // cleaner's answers keyed by field id
  laundryReady             Boolean?
  laundryOutcome           LaundryOutcome?
  laundrySkipReasonCode    String?
  laundrySkipReasonNote    String?         @db.Text
  laundryAdminOverrideNote String?         @db.Text
  laundryAdminOverrideById String?
  laundryAdminOverrideAt   DateTime?
  bagLocation              String?
  autoQaScore              Float? // computed on submission
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  job                   Job                    @relation(fields: [jobId], references: [id])
  template              FormTemplate           @relation(fields: [templateId], references: [id])
  submittedBy           User                   @relation(fields: [submittedById], references: [id])
  media                 SubmissionMedia[]
  stockTxs              StockTx[]
  mediaOverrideRequests MediaOverrideRequest[]
}

model SubmissionMedia {
  id             String    @id @default(cuid())
  submissionId   String
  fieldId        String
  mediaType      MediaType
  url            String    @db.Text
  s3Key          String
  originalUrl    String?   @db.Text
  originalS3Key  String?
  annotatedUrl   String?   @db.Text
  annotatedS3Key String?
  annotationData Json?
  sizeBytes      Int?
  mimeType       String?
  label          String?
  createdAt      DateTime  @default(now())

  submission FormSubmission @relation(fields: [submissionId], references: [id])
}

model QAReview {
  id               String    @id @default(cuid())
  jobId            String
  reviewedById     String? // null if auto-generated
  score            Float
  passed           Boolean
  notes            String?   @db.Text
  flags            Json? // array of field ids that failed
  // Authority of this review. "QA" = a real on-site QA inspection (highest
  // authority — overrides any earlier admin/auto score for the job). "ADMIN" =
  // an admin/ops quick score. "AUTO" = system-generated. The authoritative
  // outcome for a job is the latest QA review if one exists, else the latest of
  // any kind (see lib/qa/authority.ts).
  kind             String    @default("QA") // QA | ADMIN | AUTO
  editedById       String? // admin who last edited this score
  editedAt         DateTime?
  // Accountability scoring: `score` stays the FINAL approved percent (all
  // existing consumers unchanged). rawScore = pre-adjustment computed value;
  // adjustmentReason is mandatory whenever score != rawScore.
  rawScore         Float?
  adjustmentReason String?   @db.Text
  /// EXCELLENT | PASS | NEEDS_IMPROVEMENT | FAILED | MANAGEMENT_REVIEW (null = legacy)
  rating           String?
  managementReview Boolean   @default(false)
  /// When the cleaner tapped "I've read this" on their QA feedback (null = unseen)
  cleanerAcknowledgedAt DateTime?
  /// Whether the cleaner may download the (cleaner-safe) QA report for this
  /// inspection. Mirrors Report.cleanerVisible for the job report. Default true —
  /// showing a cleaner what they were marked down for is the norm; the toggle
  /// exists for the occasional inspection an admin wants to withhold while a
  /// dispute is being sorted out.
  cleanerReportVisible  Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  job               Job                @relation(fields: [jobId], references: [id])
  reviewedBy        User?              @relation("QAReviewReviewedBy", fields: [reviewedById], references: [id])
  qaFormSubmissions QaFormSubmission[]
  issues            QaIssue[]

  @@index([jobId])
  @@index([jobId, kind, createdAt])
  @@index([createdAt])
}

/// Accountability issue severity (QA per-item verdicts). Coexists intentionally
/// with the damage-entry LOW–CRITICAL scale in QaFormSubmission __qaTools.
enum QaIssueSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum FalseConfirmationStatus {
  NONE
  SUSPECTED
  CONFIRMED
  REJECTED
}

enum RectificationStatus {
  PENDING
  FIXED_BY_QA
  RETURNED_TO_CLEANER
  FIXED_BY_OTHER_CLEANER
  FIXED_BY_MANAGER
  NOT_FIXED
  ESCALATED
}

enum CoachingRecordType {
  COACHING
  WARNING
  MANAGEMENT_REVIEW
}

enum CoachingRecordStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

/// Structured, queryable QA issue raised against a clean — one row per
/// Minor/Major/Critical verdict or free-form finding. Powers scoring,
/// false-confirmation review, rectification tracking and recurring-issue
/// pattern detection (read-time queries over the cleaner/property indexes).
model QaIssue {
  id             String  @id @default(cuid())
  jobId          String
  propertyId     String
  cleanerId      String
  qaReviewId     String?
  qaSubmissionId String?
  raisedById     String

  /// settings.accountability.issueCategories key
  category              String
  fieldId               String?
  itemKey               String?
  description           String          @db.Text
  severity              QaIssueSeverity
  /// [{key, annotatedKey?}] — QA evidence photos
  qaPhotoKeys           Json?
  /// SubmissionMedia ids of the cleaner evidence under review
  cleanerMediaIds       Json?
  cleanerMarkedComplete Boolean         @default(false)
  guestReadyImpact      Boolean         @default(false)

  falseConfirmation     FalseConfirmationStatus @default(NONE)
  falseConfReviewedById String?
  falseConfReviewedAt   DateTime?

  rectificationStatus     RectificationStatus @default(PENDING)
  rectifiedById           String?
  rectificationMinutes    Int?
  rectificationCost       Float?
  rectificationBeforeKeys Json?
  rectificationAfterKeys  Json?
  /// proposed PENDING CleanerPayAdjustment created for this issue (if any)
  payAdjustmentId         String?
  escalatedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job         Job       @relation(fields: [jobId], references: [id])
  property    Property  @relation(fields: [propertyId], references: [id])
  cleaner     User      @relation("QaIssueCleaner", fields: [cleanerId], references: [id])
  raisedBy    User      @relation("QaIssueRaisedBy", fields: [raisedById], references: [id])
  rectifiedBy User?     @relation("QaIssueRectifiedBy", fields: [rectifiedById], references: [id])
  qaReview    QAReview? @relation(fields: [qaReviewId], references: [id])

  @@index([jobId])
  @@index([cleanerId, category, createdAt])
  @@index([propertyId, category, createdAt])
  @@index([rectificationStatus])
  @@index([falseConfirmation])
}

/// Coaching / warning / management-review record for a cleaner. Created by
/// managers (or recommended by pattern detection) — never automatic discipline.
model CoachingRecord {
  id                 String               @id @default(cuid())
  cleanerId          String
  createdById        String
  type               CoachingRecordType
  status             CoachingRecordStatus @default(OPEN)
  reason             String               @db.Text
  notes              String?              @db.Text
  /// QaIssue ids backing this record
  issueIds           Json?
  patternKey         String?
  retrainingRequired Boolean              @default(false)
  reviewDate         DateTime?
  acknowledgedAt     DateTime?
  /// NONE | RETRAINED | SUSPENDED | TERMINATED
  outcome            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaner   User @relation("CoachingRecordCleaner", fields: [cleanerId], references: [id])
  createdBy User @relation("CoachingRecordCreatedBy", fields: [createdById], references: [id])

  @@index([cleanerId, status])
  @@index([type, status])
}

model QaFormTemplate {
  id          String   @id @default(cuid())
  name        String
  serviceType JobType
  propertyId  String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  schema      Json
  /// True only for templates the SYSTEM owns and may rewrite in place on
  /// version bumps. The auto-upgrade used to key off the name prefix
  /// ("Default QA - …"), so an admin who edited the default template without
  /// renaming it silently lost their work the next time a job was opened.
  /// Anything an admin or the generator produced is false and never rewritten.
  isSystemManaged Boolean @default(false)
  /// The cleaner checklist (FormTemplate) this QA template was generated from.
  /// Provenance for regeneration + drift warnings.
  sourceFormTemplateId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property?          @relation(fields: [propertyId], references: [id])
  submissions QaFormSubmission[]

  @@index([serviceType, isActive, version])
  @@index([propertyId, serviceType, isActive])
}

model QaAssignment {
  id              String             @id @default(cuid())
  jobId           String
  assignedToId    String?
  createdById     String?
  pickedUpById    String?
  status          QaAssignmentStatus @default(OPEN)
  dueAt           DateTime?
  pickedUpAt      DateTime?
  completedAt     DateTime?
  onSiteStartedAt DateTime?
  onSiteEndedAt   DateTime?
  onSiteMinutes   Int?
  notes           String?            @db.Text
  /// Inspector's visit order for the day (1-based). Admin sets it when assigning;
  /// the QA "Today" list and route tab order by it. Null = unordered/backlog.
  sequence        Int?
  /// Planned inspection slot (distinct from dueAt, which is a deadline).
  scheduledFor    DateTime?
  /// QA arrival check-in at the property — mirrors the cleaner GPS check-in and
  /// is immutable once set (later fixes live in CleanerLocationPing).
  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracyM Float?
  /// Why the inspector started BEFORE the cleaner filed their form. Null on a
  /// normal pickup. Mirrors checkInSkippedReason: the action is allowed, but it
  /// must say why, and the cleaner is pushed to finish the form when it is set.
  earlyStartReason String?           @db.Text
  /// Remote review (inspector explicitly skipped on-site check-in) + why.
  checkInSkippedReason String?       @db.Text
  /// Coded counterpart to checkInSkippedReason — why the inspector reviewed
  /// from somewhere other than the property. See lib/gps/off-site-reasons.ts.
  checkInReasonCode    String?
  /// Server-side autosave of an in-progress inspection. Until this existed the
  /// only persistence was localStorage, so a half-finished inspection died with
  /// the browser profile — and "Continue review" could only ever resume on the
  /// same device the inspector started on.
  draft                Json?
  /// Original-cleaner rework offer lifecycle:
  /// NONE | OFFERED | ACCEPTED | DECLINED | EXPIRED.
  reworkOfferStatus    String?
  reworkOfferedAt      DateTime?
  reworkOfferExpiresAt DateTime?

  // ── Inspection pay ────────────────────────────────────────────────────
  // QA inspections are paid work, exactly like a clean. These mirror the
  // cleaner rail (Job.estimatedHours + JobAssignment.payRate + the per-job
  // custom payout in job meta) but live on the assignment because THAT is the
  // unit of QA work. All money is Float/DOUBLE PRECISION, matching every other
  // money column in this schema (CleanerPayAdjustment.requestedAmount,
  // User.hourlyRate, Job.fixedPrice).
  //
  /// Per-assignment override of the pay rule: FIXED | HOURLY | NONE.
  /// Null (or "DEFAULT") = fall through to settings.qaPay.defaultMode.
  payMode              String?
  /// FIXED-mode flat amount for this inspection. Null = use the settings default.
  payAmount            Float?
  /// HOURLY-mode rate override. Null = inspector's User.hourlyRate, else settings.
  payHourlyRate        Float?
  /// HOURLY-mode allocated hours. Null = actual on-site hours, else settings default.
  payHoursAllocated    Float?
  /// Admin's reason for an override (shown to the inspector on their pay screen).
  payNote              String?            @db.Text
  /// Amount frozen at settlement time. Written ONLY when a payroll run or a
  /// cleaner invoice settles this inspection, so a later rate/settings change
  /// can never retro-alter what was actually paid.
  paySettledAmount     Float?
  // Settlement stamps — the SAME discipline as CleanerPayAdjustment: an
  // inspection is money owed exactly once, and a row carrying EITHER stamp is
  // spent. See lib/finance/qa-pay.ts `isQaAssignmentAvailableForSettlement`.
  includedInPayrollRunId     String?
  includedInPayrollRunAt     DateTime?
  includedInCleanerInvoiceId String?
  includedInCleanerInvoiceAt DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  job             Job                @relation(fields: [jobId], references: [id])
  assignedTo      User?              @relation("QaAssignmentAssignedTo", fields: [assignedToId], references: [id])
  createdBy       User?              @relation("QaAssignmentCreatedBy", fields: [createdById], references: [id])
  pickedUpBy      User?              @relation("QaAssignmentPickedUpBy", fields: [pickedUpById], references: [id])
  submissions     QaFormSubmission[]
  reworkTransfers QaReworkTransfer[]

  @@index([status, dueAt])
  @@index([assignedToId, status])
  @@index([jobId, status])
  @@index([assignedToId, scheduledFor, sequence])
  @@index([includedInPayrollRunId])
  @@index([includedInCleanerInvoiceId])
}

/// Per-cleaner-per-property clean-duration statistics, rebuilt nightly from
/// completed (non-rework) jobs. Powers the QA portal's live "EST finish" and
/// the suggested visit order: how long does THIS cleaner actually take at THIS
/// property, rather than a global average.
model CleanerPropertyStat {
  id             String   @id @default(cuid())
  cleanerId      String
  propertyId     String
  /// Mean actual hours across the sample (outliers >3σ excluded).
  avgActualHours Float
  /// 90th percentile — used for the conservative arrival estimate.
  p90ActualHours Float?
  sampleCount    Int      @default(0)
  lastJobAt      DateTime?
  updatedAt      DateTime @updatedAt

  cleaner  User     @relation("CleanerPropertyStatCleaner", fields: [cleanerId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, propertyId])
  @@index([propertyId])
}

/// A QA-initiated correction record: the inspector flags work the cleaner
/// missed and (optionally) had to redo. With admin approval, billable minutes
/// and/or pay can be moved from the cleaner to the QA inspector, and the
/// cleaner's quality stats reflect the miss. Mirrors the existing pay/time
/// adjustment + approval-gate patterns.
model QaReworkTransfer {
  id                  String                 @id @default(cuid())
  jobId               String
  assignmentId        String?
  qaUserId            String
  cleanerUserId       String
  severity            QaReworkSeverity       @default(MINOR)
  reason              String                 @db.Text
  areas               Json? // list of areas/items redone
  minutesFromCleaner  Int                    @default(0)
  amountFromCleaner   Float                  @default(0)
  affectsCleanerStats Boolean                @default(true)
  status              QaReworkTransferStatus @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  adminNote           String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  job        Job           @relation(fields: [jobId], references: [id])
  assignment QaAssignment? @relation(fields: [assignmentId], references: [id])
  qaUser     User          @relation("QaReworkQa", fields: [qaUserId], references: [id])
  cleaner    User          @relation("QaReworkCleaner", fields: [cleanerUserId], references: [id])
  reviewedBy User?         @relation("QaReworkReviewedBy", fields: [reviewedById], references: [id])

  @@index([jobId, status])
  @@index([cleanerUserId, status])
  @@index([qaUserId, status])
}

enum QaReworkSeverity {
  MINOR
  MODERATE
  MAJOR
}

enum QaReworkTransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model QaFormSubmission {
  id             String   @id @default(cuid())
  jobId          String
  templateId     String
  assignmentId   String?
  qaReviewId     String?
  submittedById  String
  data           Json
  categoryScores Json?
  media          Json?
  score          Float
  passed         Boolean
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job         Job            @relation(fields: [jobId], references: [id])
  template    QaFormTemplate @relation(fields: [templateId], references: [id])
  assignment  QaAssignment?  @relation(fields: [assignmentId], references: [id])
  qaReview    QAReview?      @relation(fields: [qaReviewId], references: [id])
  submittedBy User           @relation("QaFormSubmissionSubmittedBy", fields: [submittedById], references: [id])

  @@index([jobId, createdAt])
  @@index([submittedById, createdAt])
}

model MediaOverrideRequest {
  id            String              @id @default(cuid())
  jobId         String
  submissionId  String?
  requestedById String
  decidedById   String?
  fieldId       String
  fieldLabel    String?
  reason        String?             @db.Text
  status        MediaOverrideStatus @default(PENDING)
  decisionNote  String?             @db.Text
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  job         Job             @relation(fields: [jobId], references: [id])
  submission  FormSubmission? @relation(fields: [submissionId], references: [id])
  requestedBy User            @relation("MediaOverrideRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?           @relation("MediaOverrideDecidedBy", fields: [decidedById], references: [id])

  @@unique([jobId, requestedById, fieldId, status])
  @@index([jobId, status])
  @@index([requestedById, status])
}

model IssueTicket {
  id               String    @id @default(cuid())
  jobId            String?
  clientId         String?
  propertyId       String?
  reportId         String?
  title            String
  description      String?   @db.Text
  caseType         String    @default("OPS")
  source           String?
  severity         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED (legacy, kept for backward compat)
  state            CaseState @default(OPEN)
  slaBreachAt      DateTime?
  assignedToUserId String?
  clientVisible    Boolean   @default(false)
  clientCanReply   Boolean   @default(true)
  resolutionNote   String?   @db.Text
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job         Job?             @relation(fields: [jobId], references: [id])
  client      Client?          @relation(fields: [clientId], references: [id])
  property    Property?        @relation(fields: [propertyId], references: [id])
  report      Report?          @relation(fields: [reportId], references: [id])
  assignedTo  User?            @relation("IssueTicketAssignedTo", fields: [assignedToUserId], references: [id])
  comments    CaseComment[]
  attachments CaseAttachment[]
  transitions CaseTransition[]
  /// CP-7 — maintenance items auto-created from this case (DAMAGE cases only).
  maintenanceItems PropertyMaintenanceItem[] @relation("CaseMaintenanceItems")
  /// D1 — the damage item that opened this case, when it came from a report.
  /// At most one: the case↔item pairing is 1:1 (see DamageItem.caseId).
  damageItem DamageItem? @relation("DamageItemCase")
}

model CaseTransition {
  id         String      @id @default(cuid())
