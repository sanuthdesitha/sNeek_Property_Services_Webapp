// A cleaner's own invoice, snapshotted when they "send" it, so admin can review
// it and push it to Xero as a bill (ACCPAY).
model CleanerInvoiceSubmission {
  id              String    @id @default(cuid())
  cleanerId       String
  periodStart     DateTime
  periodEnd       DateTime
  hours           Float     @default(0)
  totalAmount     Float     @default(0)
  jobCount        Int       @default(0)
  lineData        Json? // snapshot: cleaner contact + line rows for the Xero bill
  status          String    @default("SUBMITTED") // SUBMITTED | XERO_PUSHED | PAID_CLAIMED | PAID | VOID
  // The cleaner's own claim that the money arrived. Admin still has to confirm
  // it (PAID_CLAIMED -> PAID) — a payee asserting payment is not the business
  // recording it, so these fields stay separate from the paid* block above.
  paidClaimedAt        DateTime?
  paidClaimedNote      String?   @db.Text
  paidClaimedProofKeys Json? // S3 keys for a receipt/screenshot the cleaner attached
  xeroBillId      String?
  xeroExportedAt  DateTime?
  // Payment settlement recorded by admin when the invoice is marked PAID.
  paidAmount      Float? // amount actually paid (defaults to totalAmount)
  paidBankAccount String? // which bank account it was paid to
  paidNote        String?   @db.Text // optional comments about the payment
  paymentMethod   String? // how it was paid: BANK_TRANSFER | CARD | CASH | XERO | OTHER
  paidDate        DateTime? // date the money was actually sent (vs paidAt = record timestamp)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([cleanerId])
  @@index([status])
}

