}

// ─────────────────────────────────────────────
// VA teams (V1)
// ─────────────────────────────────────────────

/// A group of virtual-assistant logins acting on behalf of ONE client.
///
/// Many teams per client (an owner might use one agency for bookings and
/// another for maintenance) and many logins per team (an agency has staff and
/// turnover). The team — not the user — owns the clientId, the permissions and
/// the property scope, so revoking an agency is one row and a departing staff
/// member never leaves a login with its own private grant.
///
/// `permissions` is Json rather than columns because the client toggles these
/// per team from the portal and the set will grow (V2). It is validated by a
/// zod schema at the chokepoint, never trusted raw — see
/// lib/auth/client-portal.ts.
model VaTeam {
  id       String @id @default(cuid())
  clientId String
  name     String
  isActive Boolean @default(true)

  /// Toggled by the client. Shape validated in lib/va/permissions.ts.
  permissions Json

  /// Property scope: empty/absent means every property this client owns.
  /// Stored as ids rather than a relation because it is a filter, not
  /// ownership, and a removed property should simply drop out of scope.
  propertyIds Json?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation("VaTeamCreatedBy", fields: [createdById], references: [id])
  members   User[] @relation("VaTeamMembers")

  @@index([clientId, isActive])
}

// ─────────────────────────────────────────────
// Damage reporting (D1)
// ─────────────────────────────────────────────
// One submission groups MANY damaged items, and each item opens exactly one
// DAMAGE IssueTicket — CP-7 turns that case into a repair, so one-case-per-item
// is load-bearing, not a style choice (lib/cases/damage-maintenance.ts).

enum DamageReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CLOSED
}

/// Cleaner-facing scale. Deliberately NOT IssueTicket.severity
/// (LOW|MEDIUM|HIGH|CRITICAL) — a cleaner judges how bad the damage looks, not
/// how urgent the ops queue is. lib/damage/severity.ts maps between the two.
enum DamageSeverity {
  MINOR
  MODERATE
  MAJOR
  SEVERE
}

enum DamageSuspectedCause {
  GUEST
  WEAR
  UNKNOWN
  PRE_EXISTING
}

enum DamagePhotoSection {
  OVERVIEW
  CLOSE_UP
  CONTEXT
  EVIDENCE
}

model DamageReport {
  id           String             @id @default(cuid())
  jobId        String
  propertyId   String
  reportedById String
  status       DamageReportStatus @default(DRAFT)
  submittedAt  DateTime?
  /// False until an admin review flips it. The per-item IssueTicket is created
  /// clientVisible=false to match: the client reads damage through the cases
  /// workspace too, so a report-level gate alone would not actually hold.
  clientVisible Boolean   @default(false)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  property   Property     @relation(fields: [propertyId], references: [id])
  /// D4 — the client's in-portal sign-off. Paired with the public /verify code:
  /// the code proves the document is genuine, this proves the client read and
  /// accepted it. Both are required for a verified report.
  acknowledgedAt   DateTime?
  acknowledgedById String?
  /// Typed name at sign-off, kept verbatim — the person who accepted it may not
  /// be the account holder, and "who signed" is the point of the record.
  acknowledgedName String?

  reportedBy     User  @relation("DamageReportReportedBy", fields: [reportedById], references: [id])
  reviewedBy     User? @relation("DamageReportReviewedBy", fields: [reviewedById], references: [id])
  acknowledgedBy User? @relation("DamageReportAcknowledgedBy", fields: [acknowledgedById], references: [id])

  items DamageItem[]
  /// D3 — the public /verify code for this report's PDF, once one is issued.
  verification ReportVerification?
  /// D4 — every void this report has been through. A list, not a field: a
  /// report can be voided, redone and voided again, and each is an audit event.
  voids DamageReportVoid[]

  @@index([jobId])
  @@index([propertyId, status])
  @@index([status, submittedAt])
}

model DamageItem {
  id String @id @default(cuid())

  reportId String
  /// CP-7 anchor — the one case this item opened. Unique because two items must
  /// never share a case: the sync would then raise one repair for two faults.
  /// Nullable so a DRAFT item exists before any case does, and SetNull rather
  /// than Cascade so deleting a case never silently destroys the evidence.
  caseId String? @unique

  area           String
  category       String
  severity       DamageSeverity       @default(MODERATE)
  description    String               @db.Text
  suspectedCause DamageSuspectedCause @default(UNKNOWN)
  /// ADMIN-WRITE ONLY. Cleaners never send this and the cleaner routes must not
  /// accept it — cost is decided on the investigation page (D2).
  estimatedCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report DamageReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  case   IssueTicket?      @relation("DamageItemCase", fields: [caseId], references: [id], onDelete: SetNull)
  photos DamageItemPhoto[]

  @@index([reportId])
}

/// How a voided submission is handed back to the cleaner. Chosen at void time,
/// because the right answer depends on WHY it is being voided: a report that is
/// merely incomplete should be edited, one that documented the wrong property
/// or is unusable should be started again.
enum DamageVoidMode {
  /// Data preserved, submission undone. The cleaner edits what is there.
  KEEP_AND_REOPEN
  /// Previous answers ARCHIVED into DamageReportVoid.archivedItems (never
  /// deleted) and cleared from the report. The cleaner starts fresh.
  CLEAR_AND_REDO
}

/// One void event. Reports are NEVER hard-deleted — this is the audit trail
/// that makes voiding safe: who did it, when, why, in which mode, and (for
/// CLEAR_AND_REDO) the full snapshot of what was cleared.
model DamageReportVoid {
  id       String         @id @default(cuid())
  reportId String
  mode     DamageVoidMode
  /// Shown to the cleaner. Required — voiding someone's documented work without
  /// telling them why is how the same mistake gets made twice.
  reason     String   @db.Text
  voidedById String
  voidedAt   DateTime @default(now())
  /// CLEAR_AND_REDO only: the items and photos as they stood, so nothing a
  /// cleaner recorded is ever actually destroyed.
  archivedItems Json?
  /// The cases that were linked when this void happened, kept so the trail
  /// survives even after the items are cleared.
  archivedCaseIds Json?

  report   DamageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  voidedBy User         @relation("DamageReportVoidedBy", fields: [voidedById], references: [id])

  @@index([reportId, voidedAt])
}

model DamageItemPhoto {
  id     String @id @default(cuid())
  itemId String

  /// The photo as uploaded.
  s3Key String
  /// Annotation overlay data/render kept while the cleaner is still marking up.
  annotatedKey String?
  /// The flattened composite produced at submit by lib/qa/annotation-composite.ts.
  /// Reports render this, so annotations cannot go missing after the fact.
  flatKey String?

  caption   String?
  section   DamagePhotoSection @default(OVERVIEW)
  createdAt DateTime           @default(now())

  item DamageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, section])
}

