  sentAt                DateTime?
  paidAt                DateTime?
  // Manual payment-recording procedure (admin marks a client invoice paid).
  // paidAmount is the cumulative amount received; supports partial payments
  // (status PART_PAID until paidAmount >= totalAmount). paidDate is the date the
  // money was actually received; paidAt stays the system record timestamp. A
  // full per-payment ledger is appended to metadata.payments[].
  paidAmount            Float?
  paymentMethod         String?
  paymentReference      String?
  paidDate              DateTime?
  stripePaymentIntentId String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
