  verifiedById      String?
  category          String
  title             String
  fileName          String
  url               String    @db.Text
  s3Key             String
  mimeType          String?
  notes             String?   @db.Text
  status            String    @default("PENDING")
  requiresSignature Boolean   @default(false)
  expiresAt         DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User                   @relation("StaffDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy        User                   @relation("StaffDocumentUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy        User?                  @relation("StaffDocumentVerifiedBy", fields: [verifiedById], references: [id])
  fulfilledRequests StaffDocumentRequest[] @relation("StaffDocumentRequestFulfilledDocument")
}

model StaffDocumentRequest {
  id                  String    @id @default(cuid())
  userId              String
  requestedById       String
  fulfilledDocumentId String?
  category            String
  title               String
  notes               String?   @db.Text
  dueAt               DateTime?
  status              String    @default("REQUESTED")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User           @relation("StaffDocumentRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy       User           @relation("StaffDocumentRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  fulfilledDocument StaffDocument? @relation("StaffDocumentRequestFulfilledDocument", fields: [fulfilledDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([requestedById, status])
}

model StaffRecognition {
  id               String   @id @default(cuid())
  userId           String
  sentById         String
  title            String
  message          String?  @db.Text
  badgeKey         String
  celebrationStyle String   @default("SPOTLIGHT")
  isPublic         Boolean  @default(true)
  createdAt        DateTime @default(now())

  user   User @relation("RecognitionReceivedBy", fields: [userId], references: [id], onDelete: Cascade)
  sentBy User @relation("RecognitionSentBy", fields: [sentById], references: [id])
}

model HiringPosition {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String   @db.Text
  department        String?
  location          String?
  employmentType    String?
  applicationSchema Json
  screeningSchema   Json?
  isPublished       Boolean  @default(false)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy    User                @relation("HiringPositionCreatedBy", fields: [createdById], references: [id])
  applications HiringApplication[]
}

model HiringApplication {
  id              String    @id @default(cuid())
  positionId      String
  fullName        String
  email           String
  phone           String?
  status          String    @default("NEW")
  answers         Json?
  screeningScore  Float?
  evaluation      Json?
  resumeUrl       String?   @db.Text
  resumeKey       String?
  coverLetter     String?   @db.Text
  interviewNotes  String?   @db.Text
  interviewDate   DateTime?
  offerDetails    Json?
  rejectionReason String?   @db.Text
  reviewedById    String?
  hiredUserId     String?
  // Denormalised activity counters for quick visuals on the pipeline/cards.
  emailsSent      Int       @default(0)
  repliesReceived Int       @default(0)
  lastEmailedAt   DateTime?
  lastReplyAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  position        HiringPosition           @relation(fields: [positionId], references: [id], onDelete: Cascade)
  reviewedBy      User?                    @relation("HiringApplicationReviewedBy", fields: [reviewedById], references: [id])
  hiredUser       User?                    @relation("HiringApplicationHiredUser", fields: [hiredUserId], references: [id])
  events          HiringApplicationEvent[]
  quizAssignments QuizAssignment[]
}

/// Activity timeline for an application: status changes, emails sent, replies
/// received, notes. Powers the candidate detail timeline and the "last emailed
/// / replied" visuals.
enum HiringEventType {
  CREATED
  STATUS_CHANGE
  EMAIL_SENT
  EMAIL_REPLY
  NOTE
  ASSESSMENT
}

model HiringApplicationEvent {
  id            String          @id @default(cuid())
  applicationId String
  type          HiringEventType
  summary       String          @db.Text
  data          Json?
  actorId       String?
  createdAt     DateTime        @default(now())

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?             @relation("HiringEventActor", fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
}

/// A reusable named knowledge test (question bank) that can be assigned to any
/// candidate after they apply.
model QuizTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  schema      Json // { title, intro, passThreshold, questions: AssessmentQuestion[] }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments QuizAssignment[]
}

enum QuizAssignmentStatus {
  PENDING
  COMPLETED
  EXPIRED
}

/// A specific quiz assigned to a candidate, completed via an emailed link.
model QuizAssignment {
  id             String               @id @default(cuid())
  applicationId  String
  quizTemplateId String
  token          String               @unique
  status         QuizAssignmentStatus @default(PENDING)
  score          Float?
  result         Json?
  answers        Json?
  // When several quizzes are sent COMBINED, the merged AssessmentSchema is
  // snapshotted here (and a display title in `title`). When null, the linked
  // quizTemplate's schema is used. quizTemplateId still points at the first part.
  schema         Json?
  title          String?
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())

  application  HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  quizTemplate QuizTemplate      @relation(fields: [quizTemplateId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([token])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Real-Time Location Tracking
// ─────────────────────────────────────────────

model CleanerLocationPing {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  lat       Float
  lng       Float
  accuracy  Float?
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId, timestamp])
  @@index([userId, timestamp])
}

// ─────────────────────────────────────────────
// Client Notification Preferences
// ─────────────────────────────────────────────

model ClientNotificationPreference {
  clientId             String   @id
  notificationsEnabled Boolean  @default(true)
  notifyOnEnRoute      Boolean  @default(true)
  notifyOnJobStart     Boolean  @default(true)
  notifyOnJobComplete  Boolean  @default(true)
  preferredChannel     String   @default("EMAIL") // "EMAIL" | "SMS" | "BOTH"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Message Templates + Client Automation Rules
// ─────────────────────────────────────────────

model MessageTemplate {
  id          String          @id @default(cuid())
  name        String
  triggerType String          @default("MANUAL") // "POST_JOB" | "REVIEW_REQUEST" | "DISCOUNT" | "NEXT_CLEAN" | "MANUAL"
  jobType     String? // null = all job types; specific JobType string for targeted
  channel     String // "EMAIL" | "SMS" | "BOTH"
  category    MessageCategory @default(CUSTOM)
  subject     String? // email subject — supports {{variables}}
  body        String          @db.Text // body with {{client_name}}, {{property_address}}, {{cleaner_name}}, {{next_clean_date}}, {{job_type}}, {{feedback_url}}
  variables   Json? // declared template variables (for autocomplete)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  automationRules ClientAutomationRule[]
  emailCampaigns  EmailCampaign[]        @relation("MessageTemplateCampaigns")

  @@index([category, isActive])
}

enum MessageCategory {
  CHASE
  MARKETING
  OPERATIONAL
  SERVICE_RECOVERY
  FEEDBACK
  COMPLAINT
  ONBOARDING
  CLEANER_FACING
  LAUNDRY_FACING
  INTERNAL
  CUSTOM
}

model ClientAutomationRule {
  id           String   @id @default(cuid())
  clientId     String
  triggerType  String // "POST_JOB_REVIEW" | "POST_JOB_NEXT_CLEAN" | "POST_JOB_DISCOUNT" | "POST_JOB_CUSTOM"
  jobType      String? // null = all job types
  templateId   String?
  delayMinutes Int      @default(120)
  isEnabled    Boolean  @default(false) // OFF by default — admin must enable
  channel      String   @default("EMAIL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([clientId, isEnabled])
}

// ─────────────────────────────────────────────
// Job Feedback (post-clean client reviews)
// ─────────────────────────────────────────────

model JobFeedback {
  id                  String    @id @default(cuid())
  jobId               String    @unique
  clientId            String
  token               String    @unique @default(cuid()) // public URL token
  rating              Int? // overall 1–5, null until submitted
  // Client-perspective aspect ratings (1–5) — this is a satisfaction review, NOT
  // a QA inspection score. Kept entirely separate from QAReview.
  cleanlinessRating   Int?
  communicationRating Int?
  valueRating         Int?
  wouldRecommend      Boolean?
  comment             String?   @db.Text
  submittedAt         DateTime?
  tokenExpiresAt      DateTime
  createdAt           DateTime  @default(now())

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Finance: Payroll, Payments, Xero, Notifications
// ─────────────────────────────────────────────

enum PayrollRunStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
  VOID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PayoutMethod {
  STRIPE_CONNECT
  ABA_FILE
  MANUAL_BANK_TRANSFER
  PAYPAL
}

enum GatewayProvider {
  STRIPE
  PAYPAL
  SQUARE
}

enum GatewayStatus {
  ACTIVE
  INACTIVE
  TEST
}

enum NotificationRecipientRole {
  ADMIN
  CLEANER
  CLIENT
}

enum NotificationLogStatus {
  SENT
  FAILED
  SKIPPED
}

enum OnboardingSurveyStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OnboardingSourceType {
  ADMIN_CREATED
  CLIENT_SUBMITTED
  WEB_FORM
}

model PayrollRun {
  id                          String           @id @default(cuid())
  periodStart                 DateTime
  periodEnd                   DateTime
  status                      PayrollRunStatus @default(DRAFT)
  totalPayable                Float            @default(0)
  totalShoppingReimbursements Float            @default(0)
  totalTransportAllowances    Float            @default(0)
  totalAdjustments            Float            @default(0)
  grandTotal                  Float            @default(0)
  cleanerCount                Int              @default(0)
  createdByUserId             String?
  confirmedAt                 DateTime?
  completedAt                 DateTime?
  // Set when an ABA bank file has been generated for this run. Used to warn on
  // regeneration so the same batch isn't uploaded to the bank twice.
  abaGeneratedAt              DateTime?
  abaGeneratedById            String?
  notes                       String?          @db.Text
  metadata                    Json?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  createdBy User?    @relation("PayrollRunCreatedBy", fields: [createdByUserId], references: [id])
  payouts   Payout[]

  @@index([status, createdAt])
  @@index([periodStart, periodEnd])
}

model Payout {
  id                    String       @id @default(cuid())
  payrollRunId          String
  cleanerId             String
  amount                Float
  shoppingReimbursement Float        @default(0)
  transportAllowance    Float        @default(0)
  adjustments           Float        @default(0)
  status                PayoutStatus @default(PENDING)
  method                PayoutMethod @default(MANUAL_BANK_TRANSFER)
  stripeAccountId       String?
  stripePayoutId        String?
  bankBsb               String?
  bankAccountNumber     String?
  bankAccountName       String?
  abaReference          String?
  processedAt           DateTime?
  failureReason         String?      @db.Text
  metadata              Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  cleaner    User       @relation("CleanerPayouts", fields: [cleanerId], references: [id])

  @@index([payrollRunId, status])
  @@index([cleanerId, status])
}

model PaymentGateway {
  id               String          @id @default(cuid())
  provider         GatewayProvider
  status           GatewayStatus   @default(ACTIVE)
  label            String
  priority         Int             @default(0)
  credentials      Json
  feeRate          Float           @default(0)
  fixedFee         Float           @default(0)
  surchargeEnabled Boolean         @default(false)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  payments ClientPayment[]

  @@index([status, priority])
}

model ClientPayment {
  id               String          @id @default(cuid())
  invoiceId        String?
  quoteId          String?
  amount           Float
  currency         String          @default("AUD")
  status           String          @default("PENDING")
  gatewayId        String
  gatewayProvider  GatewayProvider
  gatewayPaymentId String?
  gatewayResponse  Json?
  feeAmount        Float?
  surchargeAmount  Float           @default(0)
  paidAt           DateTime?
  refundedAt       DateTime?
  refundAmount     Float?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoice ClientInvoice? @relation(fields: [invoiceId], references: [id])
  gateway PaymentGateway @relation(fields: [gatewayId], references: [id])

  @@index([invoiceId, status])
  @@index([gatewayId, status])
}

model XeroConnection {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  tenantName    String
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  expiresAt     DateTime
  scopes        String[]
  isActive      Boolean   @default(true)
  lastSyncAt    DateTime?
  lastSyncError String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NotificationTemplate {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  label         String
  category      String
  description   String?  @db.Text
  emailSubject  String?
  emailBodyHtml String?  @db.Text
  emailBodyText String?  @db.Text
  smsBody       String?  @db.Text
  pushTitle     String?
  pushBody      String?
  availableVars Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationPreference {
  id            String                    @id @default(cuid())
  eventKey      String
  recipientRole NotificationRecipientRole
  channel       NotificationChannel
  enabled       Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([eventKey, recipientRole, channel])
  @@index([eventKey])
}

model NotificationLog {
  id             String                @id @default(cuid())
  eventKey       String
  recipientEmail String?
  recipientRole  String
  channel        NotificationChannel
  status         NotificationLogStatus
  subject        String?
  error          String?               @db.Text
  sentAt         DateTime?
  createdAt      DateTime              @default(now())

  @@index([eventKey, createdAt])
  @@index([recipientEmail, createdAt])
}

// ─────────────────────────────────────────────
// Property Onboarding
// ─────────────────────────────────────────────

model PropertyOnboardingSurvey {
  id              String                 @id @default(cuid())
  surveyNumber    String                 @unique
  sourceType      OnboardingSourceType   @default(ADMIN_CREATED)
  status          OnboardingSurveyStatus @default(DRAFT)
  submittedById   String?
  adminReviewerId String?
  reviewedAt      DateTime?
  rejectionReason String?                @db.Text

  // Client linkage
  isNewClient      Boolean @default(false)
  clientData       Json? // { name, email, phone, address, notes }
  existingClientId String?

  // Property basics
  propertyAddress  String?
  propertySuburb   String?
  propertyState    String  @default("NSW")
  propertyPostcode String?
  propertyName     String?
  propertyNotes    String? @db.Text

  bedrooms     Int     @default(1)
  bathrooms    Int     @default(1)
  hasBalcony   Boolean @default(false)
  floorCount   Int     @default(1)
  propertyType String? // HOUSE, APARTMENT, TOWNHOUSE, UNIT, DUPLEX
  sizeSqm      Float?

  // Staffing & estimation
  requestedCleanerCount Int    @default(1)
  estimatedCleanerCount Int?
  estimatedHours        Float?
  estimatedPrice        Float?

  // iCal (optional)
  icalUrl      String?              @db.Text
  icalProvider IntegrationProvider? @default(ICAL_OTHER)

  // Laundry supplier assignment
  laundrySupplierId String?
  laundrySupplier   LaundrySupplier? @relation(fields: [laundrySupplierId], references: [id])

  // Approval/edit
  adminNotes     String? @db.Text
  adminOverrides Json? // { cleanerCount, hours, price, ... }

  // Created entities on approval
  createdClientId      String?
  createdPropertyId    String?
  createdIntegrationId String?
  createdLaundryTaskId String?
  createdJobIds        String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  submittedBy    User?   @relation("OnboardingSubmittedBy", fields: [submittedById], references: [id])
  adminReviewer  User?   @relation("OnboardingReviewedBy", fields: [adminReviewerId], references: [id])
  existingClient Client? @relation("OnboardingExistingClient", fields: [existingClientId], references: [id])
  createdClient  Client? @relation("OnboardingCreatedClient", fields: [createdClientId], references: [id])

  appliances      OnboardingAppliance[]
  specialRequests OnboardingSpecialRequest[]
  laundryDetail   OnboardingLaundryDetail?
  accessDetails   OnboardingAccessDetail[]
  jobTypeAnswers  OnboardingJobTypeAnswer[]

  @@index([status, createdAt])
  @@index([sourceType, status])
  @@index([existingClientId])
  @@index([createdPropertyId])
}

model OnboardingAppliance {
  id            String  @id @default(cuid())
  surveyId      String
  applianceType String // OVEN, FRIDGE, DISHWASHER, WASHER, DRYER, RANGEHOOD, MICROWAVE
  conditionNote String? @db.Text
  requiresClean Boolean @default(true)

  survey PropertyOnboardingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model OnboardingSpecialRequest {
  id          String  @id @default(cuid())
  surveyId    String
  description String  @db.Text
  priority    String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  area        String? // KITCHEN, BATHROOM, BEDROOM, LIVING, OUTDOOR, GARAGE

  survey PropertyOnboardingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model OnboardingLaundryDetail {
  id               String  @id @default(cuid())
  surveyId         String  @unique
  hasLaundry       Boolean @default(false)
  washerType       String? // FRONT_LOAD, TOP_LOAD, COMBO
  dryerType        String? // DRYER, COMBO, NONE
  laundryLocation  String? // INSIDE_UNIT, SEPARATE_ROOM, GARAGE, OUTDOOR
  suppliesProvided Boolean @default(false)
  detergentType    String? // STANDARD, HYPOALLERGENIC, ECO, CLIENT_PROVIDED
  notes            String? @db.Text

  survey PropertyOnboardingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model OnboardingAccessDetail {
  id          String  @id @default(cuid())
  surveyId    String
  detailType  String // LOCKBOX, KEY_LOCATION, PARKING, ENTRY_PHOTO, BUILDING_ACCESS
  value       String? @db.Text
  photoUrl    String? @db.Text
  photoKey    String?
  annotations Json? // [{ x, y, text }]
  sortOrder   Int     @default(0)

  survey PropertyOnboardingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model OnboardingJobTypeAnswer {
  id         String  @id @default(cuid())
  surveyId   String
  jobType    JobType
  answers    Json // { questionId: answer }
  isComplete Boolean @default(false)

  survey PropertyOnboardingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, jobType])
  @@index([surveyId])
}

model UploadFailure {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  filename   String
  size       Int
  mime       String
  reason     String // canonical short code, e.g. "S3_TIMEOUT", "PRESIGN_REJECTED", "CLIENT_ABORT"
  message    String?
  stack      String?   @db.Text
  context    Json? // optional payload (file slice index, retry count, etc.)
  occurredAt DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([jobId])
  @@index([resolvedAt])
}

// Geocode failures (Plan D backfill)
model GeocodeFailure {
  id         String    @id @default(cuid())
  modelType  String // "Property" | "User" | "Client"
  modelId    String
  query      String
  reason     String
  occurredAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([modelType, modelId])
  @@index([resolvedAt])
}

enum LostFoundStatus {
  REPORTED
  IN_STORAGE
  GUEST_CONTACTED
  RETURN_OFFERED
  RETURNED
  DISPOSED
  DONATED
  UNCLAIMED
  ARCHIVED
}

// Guest lost-property tracking: a cleaner reports a found item, then admins /
// cleaners / others comment, offer a return, contact the guest, and action the
// final decision. Scalar refs (no relations) keep this self-contained; the app
// batch-fetches property / user / job names as needed.
model LostFoundItem {
  id               String           @id @default(cuid())
  propertyId       String?
  jobId            String?
  reportedByUserId String?
  itemName         String
  description      String?          @db.Text
  foundLocation    String?
  photos           Json? // [{ url, key, caption? }]
  status           LostFoundStatus  @default(REPORTED)
  guestName        String?
  guestContact     String?          @db.Text
  estimatedValue   Float?
  resolution       String?          @db.Text
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  events           LostFoundEvent[]

  @@index([propertyId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model LostFoundEvent {
  id        String        @id @default(cuid())
  itemId    String
  userId    String?
  action    String // REPORTED | COMMENT | OFFER_RETURN | GUEST_CONTACTED | RETURNED | DISPOSED | STATUS_CHANGE
  note      String?       @db.Text
  meta      Json?
  createdAt DateTime      @default(now())
  item      LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}
