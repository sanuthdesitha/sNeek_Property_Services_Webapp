enum Role {
  ADMIN
  OPS_MANAGER
  QA_INSPECTOR
  CLEANER
  CLIENT
  LAUNDRY
  MAINTENANCE
  /// V1 — a virtual assistant acting on behalf of a client. Sees the client
  /// portal, scoped by their VaTeam's permissions and property scope. NEVER
  /// add this to a `requireRole([Role.CLIENT])` call: use requireClientPortal()
  /// (lib/auth/client-portal.ts), which is the one place that knows what a VA
  /// may do. Sprinkling Role.VA across ~33 routes is the exact drift class the
  /// 2026-08-15 audit kept finding.
  VA
}

