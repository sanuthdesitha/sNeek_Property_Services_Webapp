// ─────────────────────────────────────────────
// Checklist library — the database of checklist content, organised into
// modules (rooms / appliances / outdoor areas / extras) that compose into a
// per-property cleaner form. Modules auto-apply via `appliesWhen` rules
// against the property's attributes/features and can be toggled per property.
// ─────────────────────────────────────────────

/// How often a checklist item / evidence requirement applies.
enum EvidenceFrequency {
  EVERY_CLEAN
  CONDITIONAL
  ROTATIONAL
}

/// Per-property rotation tracker for ROTATIONAL checklist items: how many
/// standard cleans have passed since the item was last completed. Updated
/// inside the cleaner-submit transaction; compose-time applicability includes
/// a rotational item when cleansSinceDone + 1 >= its rotation cadence.
model PropertyRotationState {
  id                 String    @id @default(cuid())
  propertyId         String
  /// ChecklistModuleItem.key, e.g. "kitchen.top_cupboards".
  itemKey            String
  lastCompletedAt    DateTime?
  lastCompletedJobId String?
  cleansSinceDone    Int       @default(0)

  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lastCompletedJob Job?     @relation(fields: [lastCompletedJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, itemKey])
  @@index([propertyId])
}

model ChecklistModule {
  id          String  @id @default(cuid())
  /// Stable key, e.g. "kitchen", "balcony", "dishwasher".
  key         String  @unique
  title       String
  /// ROOM | APPLIANCE | OUTDOOR | SAFETY | EXTRA
  category    String  @default("ROOM")
  description String? @db.Text
  /// Auto-apply rule evaluated against the property:
  ///   { feature: "dishwasher" }                     → features.dishwasher === true
  ///   { propertyField: "hasBalcony", equals: true } → property column match
  ///   null                                          → always applies
  appliesWhen Json?
  /// Repeat this module's section per counted attribute: "bedrooms" | "bathrooms".
  repeatBy    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  items ChecklistModuleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model ChecklistModuleItem {
  id           String    @id @default(cuid())
  moduleId     String
  /// Stable key doubling as the generated form-field id, e.g. "kitchen.benchtops".
  key          String
  label        String
  instructions String?   @db.Text
  imageUrl     String?   @db.Text
  videoUrl     String?   @db.Text
  /// checkbox (default) | yesno | photo | video — maps to the form field type.
  fieldType    String    @default("checkbox")
  required     Boolean   @default(false)
  minPhotos    Int?
  /// Evidence stamp tag for photo/video items: before | after | damage.
  stampTag     String?
  /// Ticked by default when the module applies (admin can still turn off).
  defaultOn    Boolean   @default(true)
  /// Which job types include this item (empty = all job types).
  jobTypes     JobType[]
  /// Optional per-item auto-apply rule (same shape as the module rule) for
  /// items inside a broader module, e.g. the dishwasher line in "Kitchen".
  appliesWhen  Json?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)

  /// Evidence taxonomy — LIVING | KITCHEN | BATHROOM | BEDROOM | OUTDOOR |
  /// FINAL | PROPERTY_CONFIRM | LAUNDRY_CONFIRM. Drives QA grouping + the
  /// missing-mandatory-evidence scoring rule.
  evidenceCategory     String?
  /// How often this item applies: every clean (default), only when an
  /// exception is reported (CONDITIONAL + conditionKey), or on a rotation
  /// (ROTATIONAL + rotationEveryNCleans, tracked per property).
  frequency            EvidenceFrequency @default(EVERY_CLEAN)
  /// For CONDITIONAL items: stable exception key (guest_mess | damage |
  /// stains | mold | missing_supplies | maintenance | guest_belongings |
  /// broken_appliance | inaccessible | insufficient_time | dirty_sofa_linen |
  /// qa_issue | qa_rectification_before | qa_rectification_after).
  conditionKey         String?
  /// For ROTATIONAL items: due every N standard cleans (property can override
  /// via its checklist profile selections).
  rotationEveryNCleans Int?
  maxPhotos            Int?
  /// Default issue severity when QA fails this item: low | medium | high.
  severity             String?

  module ChecklistModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, key])
  @@index([moduleId, sortOrder])
}

/// One checklist profile per property: which modules/items are on or off (with
/// per-job-type item flags), custom items, and the approval + generated
/// FormTemplate linkage. Approving materialises FormTemplate(s) and registers
/// them in AppSettings.propertyFormTemplateOverrides for this property only.
model PropertyChecklistProfile {
  id                   String    @id @default(cuid())
  propertyId           String    @unique
  /// {
  ///   modules: { [moduleKey]: { enabled: bool, items: { [itemKey]: { enabled: bool, jobTypes?: JobType[] } } } },
  ///   customItems: [{ id, moduleKey?, label, instructions?, fieldType?, jobTypes?: JobType[] }]
  /// }
  selections           Json
  /// DRAFT | APPROVED | STALE (STALE = features/library changed since approval).
  status               String    @default("DRAFT")
  approvedById         String?
  approvedAt           DateTime?
  /// { [jobType]: generatedFormTemplateId } — the materialised per-property forms.
  generatedTemplateIds Json?
  /// Catalog/library version last pulled into this property's selections via the
  /// explicit "Update from standard" action. When it differs from the current
  /// CATALOG_VERSION the profile shows a "standard updated" badge. Null = never
  /// synced from standard (legacy / pre-redesign profiles).
  syncedLibraryVersion String?
  /// Set when this property's checklist was (re)generated from the STANDARD
  /// Airbnb photo-proof library so the fleet rollout is auditable/resumable.
  standardAppliedAt    DateTime?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("ChecklistProfileApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integration {
