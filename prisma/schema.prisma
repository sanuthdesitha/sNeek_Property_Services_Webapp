model Report {
  id                    String    @id @default(cuid())
  jobId                 String    @unique
  htmlContent           String?   @db.Text
  pdfUrl                String?   @db.Text
  s3Key                 String?
  generatedAt           DateTime?
  sentToClient          Boolean   @default(false)
  sentAt                DateTime?
  clientVisible         Boolean   @default(true)
  cleanerVisible        Boolean   @default(true)
  laundryVisible        Boolean   @default(false)
  visibilityNote        String?   @db.Text
  visibilityUpdatedAt   DateTime?
  visibilityUpdatedById String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  themeId String?
  theme   ReportTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  job                 Job           @relation(fields: [jobId], references: [id])
  issueTickets        IssueTicket[]
  visibilityUpdatedBy User?         @relation("ReportVisibilityUpdatedBy", fields: [visibilityUpdatedById], references: [id])

  @@index([themeId])
}

/// Public verification for a job report. `code` is a non-enumerable
/// crypto-random token (Crockford base32, no ambiguous characters) printed on
/// the report; the public /verify/[code] page resolves it to a DEDICATED
/// minimal view (never the internal report). `revokedAt` kills a code without
/// deleting the audit trail.
/// What a verification code stands for. A cleaning report and a damage report
/// are separately verifiable documents — a client holding a damage PDF must be
/// able to check THAT, not the clean it came from.
enum ReportVerificationKind {
  CLEANING
  DAMAGE
}

model ReportVerification {
  id             String                 @id @default(cuid())
  code           String                 @unique
  kind           ReportVerificationKind @default(CLEANING)
  /// Set for CLEANING, NULL for DAMAGE (the damage report carries its own job).
  jobId          String?
  /// Set for DAMAGE, NULL for CLEANING.
  damageReportId String?                @unique
  createdAt      DateTime               @default(now())
  revokedAt      DateTime?

  job          Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  damageReport DamageReport? @relation(fields: [damageReportId], references: [id], onDelete: Cascade)

  /// One CLEANING code per job, as before. DAMAGE rows leave jobId NULL, and
  /// Postgres treats NULLs as distinct, so a job with several damage reports
  /// gets a code for each — uniqueness for those is carried by damageReportId.
  @@unique([jobId, kind])
}

enum ReportThemeKind {
  COMPACT
  MAGAZINE
  DETAILED
  CUSTOM
}

model ReportTheme {
  id              String          @id @default(cuid())
  name            String
  kind            ReportThemeKind @default(CUSTOM)
  isDefault       Boolean         @default(false)
  isActive        Boolean         @default(true)
  layout          Json
  logoUrl         String?
  primaryColorHsl String?
  accentColorHsl  String?
  titleTemplate   String?
  footerHtml      String?         @db.Text
  createdById     String?
  createdBy       User?           @relation("ReportThemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  reports         Report[]

  @@index([isActive])
  @@index([isDefault])
}

model CaseComment {
